{
  "$schema": "https://openapi.vercel.sh/vercel.json",

  "cleanUrls": true,

  "trailingSlash": false,

  "headers": [

    {
      "source": "/(.*)",

      "headers": [

        {
          "key": "X-Content-Type-Options",

          "value": "nosniff"
        },

        {
          "key": "X-Frame-Options",

          "value": "DENY"
        },

        {
          "key": "Referrer-Policy",

          "value": "strict-origin-when-cross-origin"
        },

        {
          "key": "Permissions-Policy",

          "value": "camera=(), microphone=(), geolocation=()"
        },

        {
          "key": "Strict-Transport-Security",

          "value": "max-age=31536000; includeSubDomains"
        },

        {
          "key": "Content-Security-Policy",

          "value": "default-src 'self'; script-src 'self' https://esm.sh; connect-src 'self' https://lwslyhxyrvquvxhsxdsn.supabase.co wss://lwslyhxyrvquvxhsxdsn.supabase.co https://esm.sh; style-src 'self'; img-src 'self' data: blob:; font-src 'self' data:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
        }

      ]

    }

  ]

}
